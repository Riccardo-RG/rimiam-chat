{
  "name": "miriam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "worker": "tsx --env-file=.env src/worker.ts",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "test": "vitest run",
    "test:e2e": "node --env-file=.env --import tsx tests/run-e2e.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check src scripts tests README.md package.json tsconfig.json tsconfig.backend.json next.config.ts eslint.config.mjs playwright.config.ts vitest.config.ts compose.yaml",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "test:setup": "tsx --env-file=.env scripts/test-db.ts",
    "setup:env": "tsx scripts/setup-env.ts",
    "api": "node --env-file=.env --import tsx src/api.ts",
    "build:backend": "tsc -p tsconfig.backend.json",
    "start:api": "node --env-file=.env dist/backend/api.js",
    "start:worker": "node --env-file=.env dist/backend/worker.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.50",
    "@aws-sdk/client-s3": "3.1131.0",
    "ai": "7.0.94",
    "better-auth": "1.7.3",
    "graphile-worker": "0.18.0",
    "livekit-client": "2.22.3",
    "livekit-server-sdk": "2.19.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
