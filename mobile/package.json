{
  "name": "rimiam-mobile",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "eslint --max-warnings=0 App.tsx app.config.ts index.ts src tests",
    "format:check": "prettier --check App.tsx app.config.ts index.ts metro.config.js eslint.config.mjs src tests package.json tsconfig.json",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "bundle": "expo export --platform ios --platform android",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "13.0.0",
    "@livekit/react-native": "3.2.0",
    "@livekit/react-native-expo-plugin": "1.2.0",
    "@livekit/react-native-webrtc": "150.2.0",
    "@nammayatri/react-native-tts": "0.1.0",
    "@react-native-community/datetimepicker": "^8.4.4",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.14",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-speech": "~14.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "livekit-client": "2.22.3",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.73.0"
  }
}
