# Only production inputs enter the build context, including uncommitted files.
# Do not replace this allowlist with a root COPY or a personal-file denylist.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.backend.json
!next.config.ts
!requirements-documents.txt
!src/
!src/**
!public/
!public/**
!migrations/
!migrations/*.sql
!scripts/
!scripts/render-web.sh
!scripts/render-worker.sh
!scripts/extract-document.py
!scripts/render-pdf-preview.py

# A permitted source directory must not accidentally admit nested credentials.
**/.env
**/.env.*
**/.npmrc
**/.git
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.keystore
**/.DS_Store
