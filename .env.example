DATABASE_URL=postgres://miriam:miriam_local_only@127.0.0.1:54329/miriam
BETTER_AUTH_URL=http://127.0.0.1:3000
# Optional public contact and published operator privacy notice, shown on /connessioni-e-dati.
# RIMIAM_PRIVACY_CONTACT_EMAIL=
# RIMIAM_PRIVACY_NOTICE_URL=

# Generate a local secret: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional Google account sign-in; separate from Calendar/Gmail access below.
# Configure a Web OAuth client with callback <BETTER_AUTH_URL>/api/auth/callback/google.
# Requests only openid/email/profile; no offline access or stored Google tokens.
# Setup and live checks: docs/development/GOOGLE_SIGN_IN.md.
# GOOGLE_AUTH_CLIENT_ID=
# GOOGLE_AUTH_CLIENT_SECRET=
# Optional Web sign-in with personal and work/school Microsoft accounts.
# Register an Entra Web app with callback <BETTER_AUTH_URL>/api/auth/callback/microsoft.
# Identity scopes only (openid/profile/email). Keep separate from Microsoft mailbox access.
# Setup and live checks: docs/development/MICROSOFT_SIGN_IN.md.
# MICROSOFT_AUTH_CLIENT_ID=
# MICROSOFT_AUTH_CLIENT_SECRET=
# Local mail viewer is loopback-only. Production must supply a real mail transport.
LOCAL_MAIL=true
# For hosted verification, password recovery and explicitly requested invitations:
# MAIL_PROVIDER=resend, LOCAL_MAIL=false,
# HTTPS BETTER_AUTH_URL, a verified sender domain and server-side credentials.
MAIL_PROVIDER=unconfigured
# RESEND_API_KEY=
# MAIL_FROM=
AI_MODE=unconfigured
# Optional beta diagnostics, never secrets. APP_REVISION is a deployed commit SHA.
# APP_REVISION=
# AI_USAGE_RATES_JSON=[]
# Per-model USD/token tariff snapshots: format and coverage in docs/development/BETA_FEEDBACK.md.
# Operational expansion budget: insufficient results remain deferred, never accepted.
AI_CONTEXT_ROUNDS=4
# Rolling invocation admission limits (0 disables new dispatches). These are
# operational cost/abuse guards, not dollar budgets or context/token cutoffs.
# Unknown/failed attempts count; changing these values requires operator access.
AI_MAX_INVOCATIONS_PER_MINUTE=20
AI_MAX_INVOCATIONS_PER_DAY=500
AI_MAX_WORKSPACE_INVOCATIONS_PER_DAY=200
# Preferred real adapter for Conversation and image interpretation:
# No runtime fixture mode: deterministic doubles live only in tests.
# AI_MODE=openai
# OPENAI_API_KEY=
# AI_MODEL=gpt-4.1-mini
# Optional alternative adapter:
# AI_MODE=anthropic
# ANTHROPIC_API_KEY=

# AI_MODE=ollama uses Ollama's native /api/chat structured-output endpoint.
# Use a trusted local/self-hosted endpoint and an explicitly installed model.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=

# Additional operator-approved destinations for the Home assistant picker.
# Use the same catalog and secrets on the Web/API and worker. Keys stay server-side.
# RIMIAM_ASSISTANT_CONNECTIONS='[{"id":"local-model","label":"My local model","kind":"model","provider":"ollama","model":"my-installed-model"},{"id":"studio","label":"Studio assistant","kind":"agent","url":"https://agent.example.com/contribute","readOnly":true,"tokenEnv":"RIMIAM_AGENT_STUDIO_TOKEN"}]'
# RIMIAM_AGENT_STUDIO_TOKEN=
# See docs/development/ASSISTANT_CONNECTIONS.md for the contribution protocol.

# Optional activation for the web research capability.
RESEARCH_PROVIDER=unconfigured
# Set RESEARCH_PROVIDER=brave and supply a server-side key during WIRE.
# BRAVE_SEARCH_API_KEY=

# Local PDF/DOCX extraction requires pypdf and python-docx in this Python runtime.
# Omit to use python3 from PATH. No cloud credential is needed for local parsing.
# Install requirements-documents.txt in a local venv; never depend on Codex's bundled runtime in production.
# DOCUMENT_PYTHON_PATH=/absolute/path/to/MIRIAM/.venv/bin/python
# Images use the selected OpenAI or Anthropic model after explicit file disclosure.
# Voice transcription is a separate, replaceable server-side adapter.
TRANSCRIPTION_PROVIDER=unconfigured
# TRANSCRIPTION_PROVIDER=openai
# TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# The same OPENAI_API_KEY above can serve both model and transcription.

# Google Calendar/Gmail: registered web OAuth application; user consent is separate.
# New Google integration grants to offer: calendar, email, or calendar,email.
# Enable Gmail API for email and Calendar API for calendar in your own Cloud project.
# Web and worker share these values. Sign-in and account/invitation delivery use separate credentials.
# Unset offers both capabilities when configured; an empty value disables new grants.
# GOOGLE_OAUTH_CAPABILITIES=calendar
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/v1/integrations/google/callback
# Optional Outlook.com / Microsoft 365 mail and calendar consent, separate from sign-in.
# Entra Web redirect and delegated User.Read, offline_access. Calendar adds Calendars.ReadBasic;
# mail adds Mail.Read and Mail.Send in a separate grant.
# MICROSOFT_MAIL_CLIENT_ID=
# MICROSOFT_MAIL_CLIENT_SECRET=
# MICROSOFT_MAIL_REDIRECT_URI=http://127.0.0.1:3000/api/v1/integrations/microsoft/callback

# Optional standalone multi-client API; shares auth/database configuration with web.
API_HOST=127.0.0.1
API_PORT=3002

# Human-only Workspace audio calls; Cloud token revocation is required by this adapter.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# Recording consent is separate from microphone permission and from post-call analysis.
# Private S3-compatible bucket accessible by LiveKit egress and the backend:
# CALL_STORAGE_BUCKET=
# CALL_STORAGE_REGION=
# CALL_STORAGE_ACCESS_KEY=
# CALL_STORAGE_SECRET_KEY=
# CALL_STORAGE_ENDPOINT=
# CALL_STORAGE_PATH_STYLE=false
# Operational guard, never silent truncation; exceeding it leaves transcription failed/recoverable.
# CALL_RECORDING_MAX_BYTES=536870912
# FFMPEG_PATH=ffmpeg

# Optional Web Push: off until explicitly configured and each device opts in.
WEB_PUSH_ENABLED=false
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_SUBJECT=mailto:your-operational-contact@example.com
# Keep VAPID keys and BETTER_AUTH_SECRET stable across web/worker restarts.

# Optional direct notifications for the React Native app (docs/development/NATIVE_PUSH.md).
# Native sender identity, set on API and worker:
NATIVE_PUSH_ENABLED=false
# FCM_PROJECT_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# APNS_ENVIRONMENT=sandbox
# Sender credentials, set only on the worker:
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=
# APNS_KEY_ID=
# APNS_PRIVATE_KEY=
# Key rotation requires devices to opt in again; never commit private keys.
