DATABASE_URL=postgres://miriam:miriam_local_only@127.0.0.1:54329/miriam
BETTER_AUTH_URL=http://127.0.0.1:3000
# Generate a local secret: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional Google account sign-in; separate from Calendar/Gmail access below.
# Configure a Web OAuth client with callback <BETTER_AUTH_URL>/api/auth/callback/google.
# Requests only openid/email/profile; no offline access or stored Google tokens.
# Setup and live checks: docs/development/GOOGLE_SIGN_IN.md.
# GOOGLE_AUTH_CLIENT_ID=
# GOOGLE_AUTH_CLIENT_SECRET=
# Local mail viewer is loopback-only. Production must supply a real mail transport.
LOCAL_MAIL=true
# For hosted verification, password recovery and explicitly requested invitations:
# MAIL_PROVIDER=resend, LOCAL_MAIL=false,
# HTTPS BETTER_AUTH_URL, a verified sender domain and server-side credentials.
MAIL_PROVIDER=unconfigured
# RESEND_API_KEY=
# MAIL_FROM=
AI_MODE=unconfigured
# Optional beta diagnostics, never secrets. APP_REVISION is a deployed commit SHA.
# APP_REVISION=
# AI_USAGE_RATES_JSON=[]
# Per-model USD/token tariff snapshots: format and coverage in docs/development/BETA_FEEDBACK.md.
# Operational expansion budget: insufficient results remain deferred, never accepted.
AI_CONTEXT_ROUNDS=4
# Preferred real adapter for Conversation and image interpretation:
# No runtime fixture mode: deterministic doubles live only in tests.
# AI_MODE=openai
# OPENAI_API_KEY=
# AI_MODEL=gpt-4.1-mini
# Optional alternative adapter:
# AI_MODE=anthropic
# ANTHROPIC_API_KEY=

# AI_MODE=ollama uses Ollama's native /api/chat structured-output endpoint.
# Use a trusted local/self-hosted endpoint and an explicitly installed model.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=

# Optional activation for the web research capability.
RESEARCH_PROVIDER=unconfigured
# Set RESEARCH_PROVIDER=brave and supply a server-side key during WIRE.
# BRAVE_SEARCH_API_KEY=

# Local PDF/DOCX extraction requires pypdf and python-docx in this Python runtime.
# Omit to use python3 from PATH. No cloud credential is needed for local parsing.
# Install requirements-documents.txt in a local venv; never depend on Codex's bundled runtime in production.
# DOCUMENT_PYTHON_PATH=/absolute/path/to/MIRIAM/.venv/bin/python
# Images use the selected OpenAI or Anthropic model after explicit file disclosure.
# Voice transcription is a separate, replaceable server-side adapter.
TRANSCRIPTION_PROVIDER=unconfigured
# TRANSCRIPTION_PROVIDER=openai
# TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# The same OPENAI_API_KEY above can serve both model and transcription.

# Google Calendar/Gmail: registered web OAuth application; user consent is separate.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/v1/integrations/google/callback

# Optional standalone multi-client API; shares auth/database configuration with web.
API_HOST=127.0.0.1
API_PORT=3002

# Human-only Workspace audio calls; Cloud token revocation is required by this adapter.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# Recording consent is separate from microphone permission and from post-call analysis.
# Private S3-compatible bucket accessible by LiveKit egress and the backend:
# CALL_STORAGE_BUCKET=
# CALL_STORAGE_REGION=
# CALL_STORAGE_ACCESS_KEY=
# CALL_STORAGE_SECRET_KEY=
# CALL_STORAGE_ENDPOINT=
# CALL_STORAGE_PATH_STYLE=false
# Operational guard, never silent truncation; exceeding it leaves transcription failed/recoverable.
# CALL_RECORDING_MAX_BYTES=536870912
# FFMPEG_PATH=ffmpeg
